  },
  {
    "id": 1573,
    "date": "2022-12-09T17:20:03+00:00",
    "from": "tour2020",
    "text": "Bonnie dog\n\nThis is a personal photo journal such that if you want the story behind the photo, you will need to direct reply to me, and I will explain the details further.",
    "media": null
  },
  {
    "id": 1574,
    "date": "2022-12-09T17:31:14+00:00",
    "from": "tour2020",
    "text": "Bonnie teaches me about life.\nLong story. \nOn the road passing though Richmond Virginia. \nAt the library, outside using internet wifi.\nTyping on pad is futile.\nGood to know you are listening. \nWill reply later.\n\nhttps://maps.app.goo.gl/qm7E62FxGfbjXWQj8",
    "media": "1574.jpg"
  },
