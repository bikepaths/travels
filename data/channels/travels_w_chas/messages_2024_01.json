  },
  {
    "id": 2226,
    "date": "2024-01-09T21:25:42+00:00",
    "from": "tour2020",
    "text": "I spend time reading books from the free library. There is also a fabulous free table at the BLM camp.\n\nA very good book about the days of the old American west, the real, authentic cowboy of old.\n\nHighly recommended.",
    "media": null
  },
